

.ledger-row { display:flex; align-items:center; justify-content:space-between; padding:26rpx 0; border-bottom:1rpx solid #dfe5ea; }.ledger-title { font-size:28rpx; font-weight:650; }.ledger-meta { margin-top:10rpx; color:#7b8794; font-size:22rpx; }.ledger-side { text-align:right; }.ledger-amount { font-size:28rpx; font-weight:700; }.ledger-amount.income { color:#278b6b; }.ledger-amount.expense { color:#c85f2a; }.ledger-side button { display:inline-flex; align-items:center; justify-content:center; height:50rpx; margin:14rpx 0 0 10rpx; padding:0 12rpx; border:1rpx solid #d8e0e6; background:#fff; color:#435160; font-size:21rpx; line-height:50rpx; }.ledger-side button.delete { color:#c83b3b; }
