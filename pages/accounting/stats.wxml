<view class="page"><view class="page-title">收支统计</view><view class="page-subtitle">已确认和已修改账单统计</view><view class="stats-total" wx:if="{{summary}}"><view><text>收入</text><strong>¥{{summary.incomeText}}</strong></view><view><text>支出</text><strong>¥{{summary.expenseText}}</strong></view><view><text>余额</text><strong>¥{{summary.balanceText}}</strong></view></view><view class="section"><view class="section-title">支出分类</view><view class="panel empty" wx:if="{{!summary || summary.categories.length === 0}}">暂无分类数据</view><view class="category-stat" wx:for="{{summary.categories}}" wx:key="category"><view class="category-stat-head"><text>{{item.category}}</text><text>¥{{item.amountText}}</text></view><view class="bar"><view style="width: {{item.ratio}}%;"></view></view></view></view></view>

