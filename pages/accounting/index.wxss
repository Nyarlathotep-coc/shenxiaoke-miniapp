.account-summary { display:grid; grid-template-columns:repeat(3, 1fr); margin:28rpx 0; padding:28rpx 0; border-top:1rpx solid #e0e5e9; border-bottom:1rpx solid #e0e5e9; }.account-summary view { display:flex; flex-direction:column; align-items:center; color:#7b8794; font-size:22rpx; }.summary-value { margin-top:10rpx; color:#283542; font-size:28rpx; font-weight:700; }.summary-value.income { color:#278b6b; }.summary-value.expense { color:#c85f2a; }.entry-panel textarea { box-sizing:border-box; width:100%; height:160rpx; padding:20rpx; border-radius:8rpx; background:#f5f7f9; }.entry-actions { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; margin-top:20rpx; }.voice-button { display:flex; align-items:center; justify-content:center; margin:0; border:1rpx solid #e4b59f; background:#fff8f4; color:#a6441c; font-size:28rpx; }.voice-button.recording { background:#c85f2a; color:#fff; }.pending-card { margin-bottom:16rpx; padding:24rpx; border:1rpx solid #f0d8bd; border-radius:10rpx; background:#fffaf3; }.pending-title { font-size:29rpx; font-weight:650; }.pending-summary { margin-top:10rpx; color:#a15d2b; font-size:24rpx; }.pending-actions { display:grid; grid-template-columns:1.2fr 1fr 1fr; gap:10rpx; margin-top:20rpx; }.pending-actions button { min-height:64rpx; margin:0; padding:0 8rpx; font-size:23rpx; }.recent-row { display:flex; align-items:center; justify-content:space-between; padding:20rpx 0; border-bottom:1rpx solid #dfe5ea; }.recent-row text { display:block; margin-top:8rpx; color:#7b8794; font-size:22rpx; }.recent-amount { font-size:27rpx !important; font-weight:700; }.recent-amount.income { color:#278b6b; }.recent-amount.expense { color:#c85f2a; }.stats-button { width:100%; margin-top:24rpx; }

