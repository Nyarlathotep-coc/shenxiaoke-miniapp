.account-summary { display:grid; grid-template-columns:repeat(3, 1fr); margin:28rpx 0; padding:28rpx 0; border-top:1rpx solid #e0e5e9; border-bottom:1rpx solid #e0e5e9; }.account-summary view { display:flex; flex-direction:column; align-items:center; color:#7b8794; font-size:22rpx; }.summary-value { margin-top:10rpx; color:#283542; font-size:28rpx; font-weight:700; }.entry-panel textarea { box-sizing:border-box; width:100%; height:160rpx; padding:20rpx; border-radius:8rpx; background:#f5f7f9; }.entry-actions { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; margin-top:20rpx; }.voice-button { display:flex; align-items:center; justify-content:center; margin:0; border:1rpx solid #e4b59f; background:#fff8f4; color:#a6441c; font-size:28rpx; }.stats-button { width:100%; margin-top:24rpx; }

