<view class="page"><view class="page-title">AI 记账</view><view class="page-subtitle">输入文字或语音，确认后才会入账</view><view class="account-summary"><view><text>本月收入</text><text class="summary-value income">¥{{summary.incomeText}}</text></view><view><text>本月支出</text><text class="summary-value expense">¥{{summary.expenseText}}</text></view><view><text>结余</text><text class="summary-value">¥{{summary.balanceText}}</text></view></view><view class="panel entry-panel"><textarea value="{{input}}" placeholder="例如：午饭10元，电影40元" maxlength="200" bindinput="onInput"/><view class="entry-actions"><button class="voice-button {{recording ? 'recording' : ''}}" bindtap="voiceInput">{{recording ? '结束录音' : '语音录入'}}</button><button class="primary-button" bindtap="parse">识别账单</button></view><view class="recording-hint" wx:if="{{recordingHint}}">{{recordingHint}}</view></view><view class="section" wx:if="{{pendingEntries.length}}"><view class="section-heading"><text class="section-title">待确认账单</text><text class="section-link">{{pendingEntries.length}} 笔</text></view><view class="pending-card" wx:for="{{pendingEntries}}" wx:key="id"><view class="pending-title">{{item.description}} · {{item.category}}{{item.type === 'income' ? '收入' : '支出'}}</view><view class="pending-summary">{{item.amount ? '已识别金额：¥' + item.amount : '未识别到金额，请补充'}} · {{item.occurredAtLabel}}</view><view class="pending-actions"><button class="primary-button" data-index="{{index}}" bindtap="confirmPending">确认入账</button><button class="secondary-button" data-index="{{index}}" bindtap="editPending">修改</button><button class="danger-button" data-index="{{index}}" bindtap="cancelPending">取消</button></view></view></view><view class="section"><view class="section-heading"><text class="section-title">最近账单</text><text class="section-link" bindtap="goLedger">全部账单</text></view><view class="panel empty" wx:if="{{entries.length === 0}}">确认后的账单会显示在这里</view><block wx:else><view class="recent-row" wx:for="{{entries}}" wx:key="id"><view><view>{{item.description}}</view><text>{{item.category}} · {{item.occurredAt}}</text></view><text class="recent-amount {{item.type}}">{{item.type === 'income' ? '+' : '-'}}¥{{item.amount}}</text></view></block></view><button class="secondary-button stats-button" bindtap="goStats">查看分类统计</button></view>

