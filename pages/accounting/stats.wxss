

.stats-total { display:grid; grid-template-columns:repeat(3, 1fr); margin-top:32rpx; padding:28rpx 0; border-top:1rpx solid #dfe5ea; border-bottom:1rpx solid #dfe5ea; }.stats-total view { display:flex; flex-direction:column; align-items:center; color:#7b8794; font-size:23rpx; }.stats-total strong { margin-top:10rpx; color:#273442; font-size:29rpx; }.category-stat { margin-top:24rpx; }.category-stat-head { display:flex; justify-content:space-between; color:#4d5b68; font-size:25rpx; }.bar { height:14rpx; margin-top:10rpx; border-radius:7rpx; background:#e8edf1; }.bar view { height:100%; border-radius:7rpx; background:#1268e3; }
