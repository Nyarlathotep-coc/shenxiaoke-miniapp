.chat-shell { box-sizing:border-box; height:100vh; padding:88rpx 0 116rpx; }
.chat-toolbar { position:fixed; top:0; right:0; left:0; z-index:2; display:flex; justify-content:space-between; padding:14rpx 24rpx; border-bottom:1rpx solid #e4e9ee; background:#fff; }.chat-toolbar button { height:60rpx; margin:0; padding:0 22rpx; border:1rpx solid #d9e0e6; background:#fff; color:#435160; font-size:24rpx; line-height:60rpx; }
.message-list { box-sizing:border-box; height:100%; padding:20rpx 24rpx 32rpx; }.loading { padding-top:220rpx; color:#7b8794; text-align:center; }.chat-empty { display:flex; flex-direction:column; align-items:center; padding-top:100rpx; }.agent-mark { display:flex; align-items:center; justify-content:center; width:92rpx; height:92rpx; border-radius:50%; background:#eaf3ff; color:#1257ad; font-size:36rpx; font-weight:700; }.agent-mark.life { background:#e8f7f3; color:#087966; }.agent-mark.accounting { background:#fff1e9; color:#a6441c; }.chat-title { margin-top:24rpx; font-size:34rpx; font-weight:700; }.chat-note { margin-top:10rpx; color:#7b8794; }.suggestions { display:flex; flex-direction:column; width:100%; margin-top:36rpx; }.suggestions button { width:100%; margin:10rpx 0 0; border:1rpx solid #dce3e8; background:#fff; color:#344150; font-size:25rpx; }
.message { display:flex; margin:24rpx 0; }.message.user { justify-content:flex-end; }.bubble { max-width:76%; padding:20rpx 24rpx; border-radius:10rpx; background:#fff; line-height:1.6; box-shadow:0 2rpx 10rpx rgba(31,41,51,.06); }.message.user .bubble { background:#1268e3; color:#fff; }
.composer { position:fixed; right:0; bottom:0; left:0; z-index:3; display:grid; grid-template-columns:1fr 120rpx; gap:16rpx; padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #e4e9ee; background:#fff; }.composer input { height:76rpx; padding:0 22rpx; border-radius:10rpx; background:#f1f4f6; }.composer button { display:flex; align-items:center; justify-content:center; height:76rpx; margin:0; background:#b8c2cc; color:#fff; font-size:26rpx; }.composer button.ready { background:#1268e3; }

