.chat-shell { box-sizing:border-box; min-height:100vh; padding-bottom:120rpx; }.chat-empty { display:flex; flex-direction:column; align-items:center; padding-top:190rpx; }.agent-mark { display:flex; align-items:center; justify-content:center; width:92rpx; height:92rpx; border-radius:50%; background:#eaf3ff; color:#1257ad; font-size:36rpx; font-weight:700; }.agent-mark.life { background:#e8f7f3; color:#087966; }.agent-mark.accounting { background:#fff1e9; color:#a6441c; }.chat-title { margin-top:24rpx; font-size:34rpx; font-weight:700; }.chat-note { margin-top:10rpx; color:#7b8794; }.composer { position:fixed; right:0; bottom:0; left:0; display:grid; grid-template-columns:1fr 120rpx; gap:16rpx; padding:18rpx 24rpx env(safe-area-inset-bottom); border-top:1rpx solid #e4e9ee; background:#fff; }.composer input { height:76rpx; padding:0 22rpx; border-radius:10rpx; background:#f1f4f6; }.composer button { display:flex; align-items:center; justify-content:center; height:76rpx; margin:0; background:#1268e3; color:#fff; font-size:26rpx; }

