<view class="page">
  <view class="page-title">校园生活</view><view class="page-subtitle">校内服务与生活助手</view>
  <view class="assistant-strip" bindtap="goChat"><view><view class="strip-title">生活助手</view><view class="strip-desc">请假、活动、校园生活咨询</view></view><text class="strip-arrow">›</text></view>
  <view class="service-grid">
    <view class="service-item" bindtap="goLeave"><text class="service-name">请假申请</text><text>生成规范文本</text></view>
    <view class="service-item"><text class="service-name">校园活动</text><text>发现近期活动</text></view>
    <view class="service-item"><text class="service-name">今天吃什么</text><text>随机推荐餐食</text></view>
    <view class="service-item" bindtap="goAccounting"><text class="service-name">AI 记账</text><text>一句话记账</text></view>
    <view class="service-item"><text class="service-name">校园服务</text><text>常用服务入口</text></view>
    <view class="service-item"><text class="service-name">二手市场</text><text>功能入口占位</text></view>
    <view class="service-item"><text class="service-name">复习资料</text><text>功能入口占位</text></view>
  </view>
  <view class="section"><view class="section-heading"><text class="section-title">校园活动</text><text class="section-link">{{activities.length}} 项活动</text></view><view class="category-tabs"><text wx:for="{{categories}}" wx:key="*this" class="{{category === item ? 'active' : ''}}" data-category="{{item}}" bindtap="selectCategory">{{item}}</text></view><view class="search-box"><input value="{{keyword}}" placeholder="搜索活动名称、地点或主办方" bindinput="onSearch"/><text>⌕</text></view><view class="panel empty" wx:if="{{activities.length === 0}}">没有匹配的活动</view><view class="activity-card" wx:for="{{activities}}" wx:key="id" data-id="{{item.id}}" bindtap="openActivity"><view class="activity-tag">{{item.category}}</view><view class="activity-title">{{item.title}}</view><view class="activity-meta">{{item.date}} · {{item.place}}</view><view class="activity-org">{{item.organizer}}</view></view></view>
  <view class="section" wx:if="{{meal}}"><view class="section-heading"><text class="section-title">今天吃什么</text><text class="section-link" bindtap="recommendMeal">换一个</text></view><view class="meal-card"><view><view class="meal-name">{{meal.name}}</view><view class="meal-meta">{{meal.place}} · {{meal.price}}</view><view class="meal-reason">{{meal.reason}}</view></view><text class="meal-mark">荐</text></view></view>
  <view class="section"><view class="section-heading"><text class="section-title">助手会话</text><text class="section-link" bindtap="goSessions">全部会话</text></view><view class="panel empty" bindtap="goChat">开始一次生活对话</view></view>
</view>

