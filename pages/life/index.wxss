.assistant-strip { display:flex; align-items:center; justify-content:space-between; margin-top:28rpx; padding:28rpx; border-radius:12rpx; background:#e8f7f3; color:#087966; }.strip-title { font-size:32rpx; font-weight:700; }.strip-desc { margin-top:8rpx; font-size:24rpx; }.strip-arrow { font-size:48rpx; }
.service-grid { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; margin-top:28rpx; }.service-item { display:flex; flex-direction:column; min-height:100rpx; padding:24rpx; border-bottom:1rpx solid #dde4e9; background:#fff; color:#7b8794; font-size:23rpx; }.service-name { margin-bottom:10rpx; color:#273442; font-size:28rpx; font-weight:650; }
.category-tabs { display:flex; overflow-x:auto; margin-bottom:18rpx; white-space:nowrap; }.category-tabs text { margin-right:12rpx; padding:10rpx 22rpx; border-radius:22rpx; background:#fff; color:#697684; font-size:24rpx; }.category-tabs text.active { background:#1268e3; color:#fff; }.search-box { display:flex; align-items:center; margin-bottom:18rpx; padding:0 20rpx; border:1rpx solid #dce3e8; border-radius:8rpx; background:#fff; }.search-box input { flex:1; height:72rpx; font-size:24rpx; }.search-box text { color:#7b8794; font-size:38rpx; }.activity-card { margin-bottom:14rpx; padding:24rpx; border:1rpx solid #e4e9ee; border-radius:10rpx; background:#fff; }.activity-tag { display:inline-block; padding:6rpx 12rpx; border-radius:5rpx; background:#e8f7f3; color:#087966; font-size:21rpx; }.activity-title { margin-top:14rpx; font-size:29rpx; font-weight:650; }.activity-meta { margin-top:10rpx; color:#1268e3; font-size:24rpx; }.activity-org { margin-top:8rpx; color:#7b8794; font-size:22rpx; }.meal-card { display:flex; align-items:center; justify-content:space-between; padding:26rpx; border-radius:10rpx; background:#fff8f0; }.meal-name { font-size:31rpx; font-weight:700; }.meal-meta { margin-top:10rpx; color:#a15d2b; font-size:24rpx; }.meal-reason { margin-top:8rpx; color:#7b8794; font-size:23rpx; }.meal-mark { display:flex; align-items:center; justify-content:center; width:70rpx; height:70rpx; border-radius:50%; background:#f3a45c; color:#fff; font-weight:700; }

