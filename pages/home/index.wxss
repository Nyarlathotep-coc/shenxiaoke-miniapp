.hero {
  padding: 24rpx 4rpx 12rpx;
}

.hero-brand {
  color: #1268e3;
  font-size: 27rpx;
  font-weight: 700;
}

.hero-greeting {
  margin-top: 12rpx;
  font-size: 46rpx;
  font-weight: 700;
}

.hero-note {
  margin-top: 8rpx;
  color: #6b7785;
}

.agent-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 28rpx;
}

.agent-entry {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  box-sizing: border-box;
  min-height: 170rpx;
  margin: 0;
  padding: 24rpx;
  border-radius: 12rpx;
  text-align: left;
}

.agent-entry.study { background: #eaf3ff; color: #1257ad; }
.agent-entry.life { background: #e8f7f3; color: #087966; }
.agent-entry.accounting { grid-column: 1 / 3; min-height: 132rpx; background: #fff1e9; color: #a6441c; }

.agent-name { font-size: 31rpx; font-weight: 700; }
.agent-desc { margin-top: 10rpx; font-size: 23rpx; line-height: 1.45; }

.timeline-item {
  display: grid;
  grid-template-columns: 100rpx 1fr;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0f2;
}

.timeline-item:last-child { border-bottom: 0; }
.timeline-time { color: #1268e3; font-weight: 650; }
.item-title { font-weight: 650; }
.item-meta { margin-top: 8rpx; color: #7b8794; font-size: 24rpx; }

.split-section { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.summary-block { min-height: 174rpx; padding: 24rpx; border: 1rpx solid #e4e9ee; border-radius: 12rpx; background: #fff; }
.summary-block.spending { background: #fffaf7; }
.compact-list { margin-top: 18rpx; }
.compact-item { display: flex; align-items: center; margin-top: 12rpx; font-size: 23rpx; }
.dot { flex: 0 0 14rpx; width: 14rpx; height: 14rpx; margin-right: 12rpx; border: 2rpx solid #1268e3; border-radius: 50%; }
.dot.done { border-color: #9ba6b2; background: #9ba6b2; }
.done-text { color: #9ba6b2; text-decoration: line-through; }
.money { margin-top: 20rpx; color: #cf531f; font-size: 38rpx; font-weight: 700; }
.activity-row { display: flex; align-items: center; }
.activity-date { margin-right: 26rpx; color: #1268e3; font-size: 46rpx; font-weight: 700; }
.activity-date text { margin-left: 4rpx; font-size: 22rpx; font-weight: 500; }
}
