.new-button { display:flex; align-items:center; height:66rpx; margin:0; padding:0 24rpx; border-radius:8rpx; background:#1268e3; color:#fff; font-size:25rpx; }.archive-toggle { margin:24rpx 0; color:#1268e3; font-size:25rpx; }.session-list { border-top:1rpx solid #dfe5ea; }.session-row { padding:26rpx 0; border-bottom:1rpx solid #dfe5ea; }.session-main { min-width:0; }.session-title { overflow:hidden; font-size:29rpx; font-weight:650; text-overflow:ellipsis; white-space:nowrap; }.session-time { margin-top:10rpx; color:#7b8794; font-size:23rpx; }.session-actions { display:flex; margin-top:18rpx; }.session-actions button { height:56rpx; margin:0 14rpx 0 0; padding:0 22rpx; border:1rpx solid #d8e0e6; background:#fff; color:#435160; font-size:23rpx; line-height:56rpx; }.session-actions button.delete { color:#c83b3b; }

