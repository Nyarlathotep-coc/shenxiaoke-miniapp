<view class="page">
  <view class="section-heading"><view><view class="page-title">会话历史</view><view class="page-subtitle">{{agentName}}数据独立存储</view></view><button class="new-button" bindtap="createSession">新建会话</button></view>
  <view class="archive-toggle" bindtap="toggleArchived">{{showArchived ? '返回当前会话' : '查看已归档会话'}}</view>
  <view class="panel empty" wx:if="{{loading}}">正在加载…</view>
  <view class="panel empty" wx:elif="{{sessions.length === 0}}">{{showArchived ? '没有已归档会话' : '暂无会话，点击右上角开始'}}</view>
  <view class="session-list" wx:else>
    <view class="session-row" wx:for="{{sessions}}" wx:key="id" data-id="{{item.id}}" bindtap="openSession">
      <view class="session-main"><view class="session-title">{{item.title}}</view><view class="session-time">最近使用 {{item.displayTime}}</view></view>
      <view class="session-actions"><button data-id="{{item.id}}" data-archived="{{item.archived}}" catchtap="toggleSessionArchive">{{item.archived ? '恢复' : '归档'}}</button><button class="delete" data-id="{{item.id}}" catchtap="deleteSession">删除</button></view>
    </view>
  </view>
</view>

