<view class="page"><view class="panel empty" wx:if="{{loading}}">正在加载…</view><block wx:elif="{{activity}}"><view class="activity-label">{{activity.category}}</view><view class="page-title detail-title">{{activity.title}}</view><view class="detail-meta">{{activity.date}}</view><view class="detail-meta">{{activity.place}} · {{activity.organizer}}</view><view class="detail-section"><view class="section-title">活动介绍</view><view class="detail-text">{{activity.description}}</view></view><view class="detail-section"><view class="section-title">报名信息</view><view class="detail-text">活动名额 {{activity.capacity}} 人，具体报名规则以现场通知为准。</view></view><button class="primary-button detail-button" bindtap="noop">我知道了</button></block></view>

