<view class="page"><view class="page-title">请假申请</view><view class="page-subtitle">先生成文本，确认后才会保存</view><view class="form"><view class="field"><text>开始日期</text><picker mode="date" value="{{startDate}}" bindchange="onStartDate"><view class="picker-value">{{startDate || '请选择'}}</view></picker></view><view class="field"><text>结束日期</text><picker mode="date" value="{{endDate}}" bindchange="onEndDate"><view class="picker-value">{{endDate || '请选择'}}</view></picker></view><view class="field vertical"><text>请假原因</text><textarea value="{{reason}}" placeholder="请输入请假原因" maxlength="200" bindinput="onInput"/></view><button class="primary-button" bindtap="generate">生成请假文本</button></view><view class="section" wx:if="{{generatedText}}"><view class="section-title">待确认文本</view><view class="leave-preview">{{generatedText}}</view><view class="leave-actions"><button class="secondary-button" bindtap="confirmText">{{confirmed ? '已确认' : '确认文本'}}</button><button class="primary-button" bindtap="save">保存记录</button></view></view><view class="section" wx:if="{{records.length}}"><view class="section-title">我的请假记录</view><view class="record-row" wx:for="{{records}}" wx:key="id"><view>{{item.startDate}} 至 {{item.endDate}}</view><text>已保存</text></view></view></view>

