

.form { margin-top:32rpx; }.field { display:flex; align-items:center; justify-content:space-between; min-height:92rpx; border-bottom:1rpx solid #dfe5ea; }.field.vertical { display:block; padding:24rpx 0; }.field text { color:#435160; font-size:27rpx; }.picker-value { color:#1268e3; font-size:26rpx; }.field textarea { box-sizing:border-box; width:100%; height:150rpx; margin-top:18rpx; padding:18rpx; border-radius:8rpx; background:#f5f7f9; }.form .primary-button { width:100%; margin-top:28rpx; }.leave-preview { margin-top:18rpx; padding:24rpx; border:1rpx solid #f0d8bd; border-radius:8rpx; background:#fffaf3; color:#4d5b68; line-height:1.7; }.leave-actions { display:grid; grid-template-columns:1fr 1fr; gap:14rpx; margin-top:18rpx; }.leave-actions button { margin:0; }.record-row { display:flex; align-items:center; justify-content:space-between; padding:20rpx 0; border-bottom:1rpx solid #dfe5ea; color:#4d5b68; }.record-row text { color:#269174; font-size:23rpx; }
