.assistant-strip { display:flex; align-items:center; justify-content:space-between; margin-top:28rpx; padding:28rpx; border-radius:12rpx; background:#eaf3ff; color:#1257ad; }
.strip-title { font-size:32rpx; font-weight:700; }.strip-desc { margin-top:8rpx; font-size:24rpx; }.strip-arrow { font-size:48rpx; }
.segment { display:flex; padding:4rpx; border-radius:8rpx; background:#e9edf1; }.segment text { padding:10rpx 22rpx; color:#6b7785; font-size:24rpx; }.segment .active { border-radius:6rpx; background:#fff; color:#1268e3; font-weight:650; }
.quick-grid { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; margin-top:28rpx; }.quick-item { display:flex; flex-direction:column; padding:26rpx; border:1rpx solid #e4e9ee; border-radius:12rpx; background:#fff; color:#7b8794; font-size:23rpx; }.quick-title { margin-bottom:10rpx; color:#273442; font-size:28rpx; font-weight:650; }

