.assistant-strip { display:flex; align-items:center; justify-content:space-between; margin-top:28rpx; padding:28rpx; border-radius:12rpx; background:#eaf3ff; color:#1257ad; }
.strip-title { font-size:32rpx; font-weight:700; }.strip-desc { margin-top:8rpx; font-size:24rpx; }.strip-arrow { font-size:48rpx; }
.segment { display:flex; padding:4rpx; border-radius:8rpx; background:#e9edf1; }.segment text { padding:10rpx 22rpx; color:#6b7785; font-size:24rpx; }.segment .active { border-radius:6rpx; background:#fff; color:#1268e3; font-weight:650; }
.course-row { display:flex; margin-bottom:14rpx; padding:24rpx; border-left:6rpx solid #3b82dd; background:#fff; }.course-time { display:flex; flex-direction:column; width:100rpx; color:#1268e3; font-size:23rpx; }.course-time text:last-child { margin-top:8rpx; color:#8a96a2; }.course-detail view { font-size:29rpx; font-weight:650; }.course-detail text { display:block; margin-top:10rpx; color:#7b8794; font-size:23rpx; }
.week-scroll { width:100%; white-space:nowrap; }.day-column { display:inline-block; box-sizing:border-box; width:250rpx; min-height:270rpx; margin-right:12rpx; padding:18rpx; vertical-align:top; border:1rpx solid #e2e7eb; background:#fff; white-space:normal; }.day-name { margin-bottom:16rpx; font-weight:700; }.mini-course { margin-bottom:14rpx; padding:14rpx; border-left:4rpx solid #3b82dd; background:#f2f7fd; font-size:22rpx; }.mini-course view { margin:5rpx 0; font-weight:650; }.mini-course text { color:#667482; font-size:20rpx; }.day-empty { color:#9aa5b1; font-size:23rpx; }
.calendar-band { padding:28rpx; border-top:1rpx solid #dce3e8; border-bottom:1rpx solid #dce3e8; }.calendar-term { margin-top:12rpx; color:#1268e3; font-size:25rpx; }.calendar-period { margin-top:6rpx; color:#7b8794; font-size:22rpx; }.calendar-events { margin-top:22rpx; }.calendar-events view { margin-top:12rpx; font-size:24rpx; }.calendar-events text { display:inline-block; width:116rpx; color:#667482; }
.quick-grid { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; margin-top:28rpx; }.quick-item { display:flex; flex-direction:column; min-height:132rpx; padding:26rpx; border:1rpx solid #e4e9ee; border-radius:12rpx; background:#fff; color:#7b8794; font-size:23rpx; }.quick-title { margin-bottom:10rpx; color:#273442; font-size:28rpx; font-weight:650; }.progress { height:10rpx; margin-top:24rpx; border-radius:5rpx; background:#e4eaf0; }.progress view { height:100%; border-radius:5rpx; background:#1268e3; }
.todo-count { color:#7b8794; font-size:24rpx; }.todo-creator { display:grid; grid-template-columns:1fr 112rpx; gap:12rpx; margin-bottom:18rpx; }.todo-creator input { height:72rpx; padding:0 20rpx; border:1rpx solid #dce3e8; border-radius:8rpx; background:#fff; }.todo-creator button { height:72rpx; margin:0; padding:0; border-radius:8rpx; background:#1268e3; color:#fff; font-size:25rpx; line-height:72rpx; }.todo-list { border-top:1rpx solid #dfe5ea; }.todo-row { display:flex; align-items:center; justify-content:space-between; min-height:86rpx; border-bottom:1rpx solid #dfe5ea; }.todo-main { display:flex; align-items:center; min-width:0; }.todo-check { display:flex; flex:0 0 34rpx; align-items:center; justify-content:center; box-sizing:border-box; width:34rpx; height:34rpx; margin-right:16rpx; border:2rpx solid #9aa7b4; border-radius:50%; color:#fff; font-size:22rpx; }.todo-main.completed { color:#929daa; text-decoration:line-through; }.todo-main.completed .todo-check { border-color:#289b7b; background:#289b7b; }.todo-row button { height:52rpx; margin:0; padding:0 16rpx; background:transparent; color:#c83b3b; font-size:22rpx; line-height:52rpx; }.full-button { width:100%; }

