page {
  min-height: 100%;
  background: #f5f7f9;
  color: #1f2933;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
}

.page-subtitle {
  margin-top: 8rpx;
  color: #6b7785;
  font-size: 26rpx;
}

.section {
  margin-top: 36rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 650;
}

.section-link {
  color: #1268e3;
  font-size: 25rpx;
}

.panel {
  box-sizing: border-box;
  padding: 28rpx;
  border: 1rpx solid #e4e9ee;
  border-radius: 12rpx;
  background: #ffffff;
}

.empty {
  padding: 52rpx 24rpx;
  color: #8793a1;
  text-align: center;
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 80rpx;
  padding: 0 28rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  line-height: 1.2;
}

.primary-button {
  background: #1268e3;
  color: #ffffff;
}

.secondary-button {
  border: 1rpx solid #cbd4dc;
  background: #ffffff;
  color: #344150;
}

.danger-button {
  border: 1rpx solid #efc5c5;
  background: #fffafa;
  color: #c83b3b;
}

button::after {
  border: 0;
}

